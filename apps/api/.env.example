# ─────────────────────────────────────────────────────────────────────────────
# DoctorBooking API — Environment Variables
# Copy to .env and fill in your values.
# Railway: set these in the Railway project dashboard (Variables tab).
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=production
PORT=3000
API_VERSION=v1

# Database (Railway provides this automatically as DATABASE_URL when you add
# the PostgreSQL plugin — just reference it, don't override it)
DATABASE_URL="postgresql://postgres:password@localhost:5432/doctor_booking"

# JWT — generate strong secrets in production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-strong-random-64-char-secret
JWT_REFRESH_SECRET=change-me-different-strong-random-64-char-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — add your Railway public URL and any frontend domains
CORS_ORIGINS=https://your-app.up.railway.app,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Slot Locking (seconds a selected slot stays reserved)
SLOT_LOCK_TTL=120

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ── Google Sign-In (Phase 2) ─────────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Firebase (optional — for push notifications) ─────────────────────────────
# Only needed if using FCM push notifications. Leave blank to disable.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Cloudinary (optional — for image uploads) ────────────────────────────────
# Only needed for doctor/clinic photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / SMTP (optional) ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@doctorbooking.com
